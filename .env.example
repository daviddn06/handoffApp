# Production data and uploads must live outside the release checkout.
HANDOFF_DATA_DIR=/var/lib/handoff
HANDOFF_ORIGIN=https://app.handofflease.com
PORT=4742

# An authenticated SMTP provider is required for verification and password reset.
# Port 587 upgrades with mandatory STARTTLS. Port 465 requires SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Handoff <hello@handofflease.com>

# Smart import and the listing chat helper. Without a key both are offered as
# "Being set up" and the manual six step form still works.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna. gpt-5.4-mini is the cheaper fallback.
OPENAI_MODEL=

# Local development only. Use the exact Vite origin (no trailing slash).
# HANDOFF_ORIGIN=http://127.0.0.1:4741
# HANDOFF_DATA_DIR=./data
