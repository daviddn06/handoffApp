[Unit]
Description=Create a verified Handoff database and photo backup set
After=handoff.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/handoff/current
EnvironmentFile=/etc/handoff/app.env
ExecStart=/usr/bin/node deploy/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite may need its WAL shared-memory sidecar even for a read-only connection.
ReadWritePaths=/var/backups/handoff /var/lib/handoff
TimeoutStartSec=30min
MemoryMax=256M
